# Copy to .env and fill in. Never commit .env.
# The install.sh script generates the random values for you.

# Running more than one copy of this stack on the same machine? Give this
# one a prefix so its containers/network don't collide — e.g.
# INSTANCE_PREFIX=test- turns "zotero-mcp" into "test-zotero-mcp". Leave
# blank for the default name.
INSTANCE_PREFIX=

# Your Zotero user ID (a number) — find it at https://www.zotero.org/settings/keys,
# it's shown above the "Create new private key" button.
ZOTERO_USER_ID=

# A Zotero API key with read (and write, if you want the MCP to create/edit
# items) access to your library. Create one at
# https://www.zotero.org/settings/keys/new
ZOTERO_API_TOKEN=

# What MCP clients authenticate to the MCP with.
# Generate with: openssl rand -hex 32
MCP_BEARER_TOKEN=

# Port (change if it collides with something else on your machine)
MCP_PORT=7012

# Optional OAuth login, for MCP clients that sign in through an OAuth 2.1
# provider (Authentik, Keycloak, etc.) instead of taking a bearer token.
# The bearer token above keeps working either way. Leave ISSUER blank to
# keep OAuth off.
MCP_OAUTH_ISSUER=
# The public URL clients use to reach the MCP, e.g. https://zotero-mcp.example.com
MCP_OAUTH_CANONICAL_URL=
# Defaults to <issuer>/jwks/
MCP_OAUTH_JWKS_URI=
# Expected `aud` claim. Defaults to the canonical URL; some providers
# (Authentik) put the client ID here instead.
MCP_OAUTH_AUDIENCE=
MCP_OAUTH_SCOPES=
